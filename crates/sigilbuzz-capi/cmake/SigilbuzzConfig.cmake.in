# SigilbuzzConfig.cmake — find-module for the sigilbuzz cdylib.
#
# Generated from `SigilbuzzConfig.cmake.in` by configuring `@PREFIX@`
# and `@VERSION@` substitutions at install time. Drop the resulting
# file into `${prefix}/lib/cmake/Sigilbuzz/SigilbuzzConfig.cmake` and
# CMake-based consumers can pick up sigilbuzz with:
#
#     find_package(Sigilbuzz REQUIRED)
#     target_link_libraries(myapp PRIVATE Sigilbuzz::Sigilbuzz)
#
# The package exports the same `Sigilbuzz::Sigilbuzz` target a
# HarfBuzz consumer would otherwise call `HarfBuzz::HarfBuzz` on, so
# rewriting the link line to point here is enough to migrate.

set(SIGILBUZZ_VERSION "@VERSION@")
set(SIGILBUZZ_PREFIX "@PREFIX@")

include(CMakeFindDependencyMacro)

find_path(SIGILBUZZ_INCLUDE_DIR
    NAMES hb.h
    HINTS "${SIGILBUZZ_PREFIX}/include"
)

find_library(SIGILBUZZ_LIBRARY
    NAMES sigilbuzz
    HINTS "${SIGILBUZZ_PREFIX}/lib"
)

if(SIGILBUZZ_INCLUDE_DIR AND SIGILBUZZ_LIBRARY)
    add_library(Sigilbuzz::Sigilbuzz SHARED IMPORTED)
    set_target_properties(Sigilbuzz::Sigilbuzz PROPERTIES
        IMPORTED_LOCATION "${SIGILBUZZ_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${SIGILBUZZ_INCLUDE_DIR}"
    )
    set(Sigilbuzz_FOUND TRUE)
else()
    set(Sigilbuzz_FOUND FALSE)
    if(Sigilbuzz_FIND_REQUIRED)
        message(FATAL_ERROR
            "Could not find Sigilbuzz: looked under ${SIGILBUZZ_PREFIX}.")
    endif()
endif()

mark_as_advanced(SIGILBUZZ_INCLUDE_DIR SIGILBUZZ_LIBRARY)
