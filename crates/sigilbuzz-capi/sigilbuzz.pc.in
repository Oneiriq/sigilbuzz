prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sigilbuzz
Description: HarfBuzz-symbol-compatible text shaping library (sigilbuzz drop-in)
URL: https://github.com/Oneiriq/sigilbuzz
Version: @VERSION@
Libs: -L${libdir} -lsigilbuzz
Cflags: -I${includedir}
