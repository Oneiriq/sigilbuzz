#!/bin/bash
# sigilbuzz pre-push hook.
#
# Runs the same checks as CI, so problems show up before the push instead
# of after. Clippy and the tests cover the whole workspace, not just the
# root crate. Do not skip with --no-verify.
#
# Install by symlinking or copying into .git/hooks/pre-push:
#
#   ln -s ../../hooks/pre-push .git/hooks/pre-push
#
# or run scripts/install-hooks.sh from the repo root.

set -euo pipefail

echo "[sigilbuzz pre-push] running local CI gate..."

echo "  -> cargo fmt --all --check"
cargo fmt --all --check

echo "  -> cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "  -> cargo clippy --workspace --no-default-features --all-targets -- -D warnings"
cargo clippy --workspace --no-default-features --all-targets -- -D warnings

echo "  -> cargo test --workspace --all-features"
cargo test --workspace --all-features

echo "  -> cargo build --no-default-features"
cargo build --no-default-features

echo "[sigilbuzz pre-push] all checks passed."
